# RevenueCat public SDK keys (safe to ship in the app, they are not secret keys).
# Copy this file to `.env` for local dev builds. For EAS builds, set the same names as
# EAS environment variables (e.g. `eas env:create`), because `.env` is gitignored and not uploaded.
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=appl_replace_me
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=goog_replace_me

# AdMob: set to "true" to serve Google's test ads in a release build (dev builds always use test ads).
# Never tap live ads on your own device; that can get the AdMob account suspended. The `preview`
# EAS profile sets this already; leave it unset for production.
EXPO_PUBLIC_ADMOB_TEST_ADS=false
